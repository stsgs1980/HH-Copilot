{
  "name": "hh-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HH Copilot - Chrome Extension for hh.ru",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsdoc": "^64.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,html,md}": "prettier --write",
    "extension/**/*.{js,ts,jsx,tsx}": "eslint --fix",
    "*.css": "stylelint --fix",
    "*.md": "markdownlint --fix --ignore node_modules"
  },
  "scripts": {
    "lint": "eslint extension/src/ extension/background/ extension/tests/",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:fix": "eslint --fix extension/src/ extension/background/ extension/tests/",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore extension/dist",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  }
}

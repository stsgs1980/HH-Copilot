{
  "name": "hh-copilot",
  "version": "1.9.86.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "esbuild": "^0.24.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9",
    "ws": "^8.18.0"
  },
  "description": "HH Copilot - Chrome Extension for hh.ru (esbuild)",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:dev": "node ../scripts/build-dev.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "mock": "node ../scripts/serve-mock.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ background/ tests/",
    "lint:fix": "eslint --fix src/ background/ tests/",
    "lint:ci": "eslint src/ background/ tests/"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  }
}
